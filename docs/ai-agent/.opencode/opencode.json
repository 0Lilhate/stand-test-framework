{
  "$schema": "https://opencode.ai/config.json",
  "model": "alfagen/VIP-EVC-DeepSeek-V4-Flash",
  "instructions": [
    ".opencode/AGENTS.md",
    ".opencode/rules/**/*.md",
    "AGENTS.md"
  ],
  "subagent_depth": 2,
  "permission": {
    "skill": {
      "*": "allow"
    },
    "bash": {
      "*": "ask",
      "./gradlew*": "allow",
      "JAVA_HOME=* ./gradlew*": "allow",
      "mvn*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git branch*": "allow",
      "git tag*": "allow",
      "ls*": "allow",
      "find*": "allow",
      "grep*": "allow",
      "rg*": "allow",
      "cat*": "allow",
      "head*": "allow",
      "tail*": "allow",
      "wc*": "allow",
      "node*": "allow",
      "rm -rf*": "deny",
      "cmd.exe*": "deny",
      "powershell*": "deny"
    },
    "edit": {
      "**/.opencode/agents/**": "deny",
      "**/.opencode/hooks/**": "deny",
      "**/.opencode/rules/**": "deny",
      "**/.opencode/skills/**": "deny",
      "**/.opencode/commands/**": "deny",
      "**/.opencode/workflows/**": "deny",
      "**/.opencode/opencode.json": "deny",
      "**/checkstyle.xml": "deny",
      "**/pmd.xml": "deny",
      "**/pmd-ruleset.xml": "deny",
      "**/spotbugs-exclude.xml": "deny",
      "**/spotbugs-include.xml": "deny",
      "**/detekt.yml": "deny",
      "**/detekt-config.yml": "deny",
      "**/.editorconfig": "deny",
      "**/.gitignore": "deny",
      "**/.env": "deny",
      "**/.env.production": "deny",
      "**/.env.local": "deny",
      "**/tomcat/conf/context.xml": "deny",
      "**/tomcat/conf/server.xml": "deny",
      "**/tomcat/conf/web.xml": "deny"
    },
    "mcp_*": "ask",
    "task": {
      "*": "deny",
      "stand-test-kb-resolver": "allow",
      "stand-test-safety-reviewer": "allow",
      "stand-test-quality-reviewer": "allow"
    }
  },
  "provider": {
    "alfagen": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "AlfaGen",
      "options": {
        "baseURL": "https://alfagen.moscow.alfaintra.net/continue-dev",
        "apiKey": ""
      },
      "models": {
        "VIP-EVC-DeepSeek-V4-Flash": {
          "name": "LARGE"
        }
      }
    }
  },
  "mcp": {
    "memory": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "enabled": true
    },
    "sequential-thinking": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "enabled": true
    },
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp@latest"
      ],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp",
        "--browser",
        "chrome"
      ],
      "enabled": true
    }
  }
}
