{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stand-test.alfa.ru/schema/test-scenario-candidate.schema.json",
  "title": "stand-test KB ingestion - test scenario candidate",
  "description": "An extracted candidate autotest intent (goal, preconditions, action, expected per-transport effects, assertions, cleanup, negative cases). SEMANTIC content: it pre-fills stand-test-case-analysis / stand-test-scenario-design and is NEVER auto-promoted to a curated testCaseMapping - a human authors the real test. kbDependencies list the KB entry ids the scenario would need (resolved by kb-lookup, missing ones become unresolved items). Provenance and confidence mandatory; free-text rejects URLs and inline secrets. File shape: { testScenarios: [ ... ] }.",
  "type": "object",
  "additionalProperties": false,
  "required": ["testScenarios"],
  "properties": {
    "documentId": { "$ref": "#/$defs/kebabId" },
    "testScenarios": { "type": "array", "items": { "$ref": "#/$defs/testScenario" } }
  },
  "$defs": {
    "kebabId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$", "minLength": 2, "maxLength": 64 },
    "confidence": { "enum": ["high", "medium", "low"] },
    "noUrl": { "if": { "type": "string" }, "then": { "not": { "pattern": "(://|[jJ][dD][bB][cC]:)" } } },
    "secretShape": { "if": { "type": "string" }, "then": { "not": { "pattern": "([Bb]earer [A-Za-z0-9._-]{6}|[Bb]asic [A-Za-z0-9+/=]{8}|[Aa]uthorization\\s*[:=]|[Aa][Pp][Ii][-_]?[Kk][Ee][Yy]|[Xx]-[Aa][Pp][Ii]-[Kk][Ee][Yy]|[Pp]assword\\s*[:=]|[Pp]asswd\\s*[:=]|[Ss]ecret\\s*[:=]|AKIA[0-9A-Z]{12}|eyJ[A-Za-z0-9._-]{10})" } } },
    "safeShort": { "type": "string", "maxLength": 200, "allOf": [ { "$ref": "#/$defs/noUrl" }, { "$ref": "#/$defs/secretShape" } ] },
    "safeLong": { "type": "string", "maxLength": 500, "allOf": [ { "$ref": "#/$defs/noUrl" }, { "$ref": "#/$defs/secretShape" } ] },
    "idArray": { "type": "array", "items": { "$ref": "#/$defs/kebabId" }, "uniqueItems": true, "maxItems": 100 },
    "safeArray": { "type": "array", "items": { "$ref": "#/$defs/safeLong" }, "maxItems": 100 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documentId", "documentName", "quote"],
      "properties": {
        "documentId": { "$ref": "#/$defs/kebabId" },
        "documentName": { "type": "string", "minLength": 1, "maxLength": 300, "allOf": [ { "$ref": "#/$defs/noUrl" } ] },
        "documentVersion": { "type": ["string", "null"], "maxLength": 40 },
        "documentDate": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "page": { "type": ["integer", "null"], "minimum": 1 },
        "section": { "type": ["string", "null"], "maxLength": 160 },
        "heading": { "type": ["string", "null"], "maxLength": 200 },
        "quote": { "type": "string", "minLength": 1, "maxLength": 600, "allOf": [ { "$ref": "#/$defs/noUrl" }, { "$ref": "#/$defs/secretShape" } ] },
        "extractionNotes": { "type": ["string", "null"], "maxLength": 500, "allOf": [ { "$ref": "#/$defs/noUrl" }, { "$ref": "#/$defs/secretShape" } ] }
      }
    },
    "testScenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "goal", "action", "source", "confidence"],
      "properties": {
        "id": { "$ref": "#/$defs/kebabId" },
        "title": { "$ref": "#/$defs/safeShort" },
        "goal": { "$ref": "#/$defs/safeLong" },
        "preconditions": { "$ref": "#/$defs/safeArray" },
        "testData": { "$ref": "#/$defs/safeArray" },
        "action": { "$ref": "#/$defs/safeLong" },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rest": { "$ref": "#/$defs/safeArray" },
            "kafka": { "$ref": "#/$defs/safeArray" },
            "db": { "$ref": "#/$defs/safeArray" },
            "grpc": { "$ref": "#/$defs/safeArray" }
          }
        },
        "assertions": { "$ref": "#/$defs/safeArray" },
        "cleanup": { "$ref": "#/$defs/safeArray" },
        "risks": { "$ref": "#/$defs/safeArray" },
        "source": { "$ref": "#/$defs/source" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "kbDependencies": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "endpoints": { "$ref": "#/$defs/idArray" },
            "kafkaTopics": { "$ref": "#/$defs/idArray" },
            "datasources": { "$ref": "#/$defs/idArray" },
            "dbProbes": { "$ref": "#/$defs/idArray" },
            "grpcTargets": { "$ref": "#/$defs/idArray" }
          }
        }
      }
    }
  }
}
