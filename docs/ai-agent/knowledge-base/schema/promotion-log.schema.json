{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stand-test.alfa.ru/schema/promotion-log.schema.json",
  "title": "stand-test KB ingestion - promotion ledger",
  "description": "The append-only ledger of curated-KB promotions: which curated entry was promoted, from which source document + version, and when. An ops record, NOT a promotable candidate. File shape: { promotions: [ ... ] }.",
  "type": "object",
  "additionalProperties": false,
  "required": ["promotions"],
  "properties": {
    "promotions": { "type": "array", "items": { "$ref": "#/$defs/promotion" } }
  },
  "$defs": {
    "kebabId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$", "minLength": 2, "maxLength": 64 },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "noUrl": { "if": { "type": "string" }, "then": { "not": { "pattern": "(://|[jJ][dD][bB][cC]:)" } } },
    "secretShape": { "if": { "type": "string" }, "then": { "not": { "pattern": "([Bb]earer [A-Za-z0-9._-]{6}|[Bb]asic [A-Za-z0-9+/=]{8}|[Aa]uthorization\\s*[:=]|[Aa][Pp][Ii][-_]?[Kk][Ee][Yy]|[Xx]-[Aa][Pp][Ii]-[Kk][Ee][Yy]|[Pp]assword\\s*[:=]|[Pp]asswd\\s*[:=]|[Ss]ecret\\s*[:=]|AKIA[0-9A-Z]{12}|eyJ[A-Za-z0-9._-]{10})" } } },
    "safeLong": { "type": "string", "minLength": 1, "maxLength": 500, "allOf": [ { "$ref": "#/$defs/noUrl" }, { "$ref": "#/$defs/secretShape" } ] },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["curatedId", "curatedCollection", "documentId", "promotedAt"],
      "properties": {
        "curatedId": { "$ref": "#/$defs/kebabId" },
        "curatedCollection": {
          "enum": ["services", "endpoints", "kafka", "datasources", "dbProbes", "dbTables", "grpcTargets", "environments", "mappings"]
        },
        "documentId": { "$ref": "#/$defs/kebabId" },
        "documentVersion": { "type": ["string", "null"], "maxLength": 40 },
        "documentDate": { "$ref": "#/$defs/date" },
        "promotedAt": { "$ref": "#/$defs/date" },
        "confidence": { "enum": ["high", "medium", "low"] },
        "note": { "$ref": "#/$defs/safeLong" }
      }
    }
  }
}
