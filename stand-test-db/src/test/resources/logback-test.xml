<?xml version="1.0" encoding="UTF-8"?>
<!--
  Test-only Logback config for stand-test-db. Keeps unit-test output quiet (WARN and above) while
  demonstrating the correlation pattern the SDK stamps into the MDC (plan §17). The runner's WARN/ERROR
  step-failure lines stay visible (and remain capturable by ListAppender in tests); INFO/DEBUG step
  lifecycle is suppressed here so the test log is not noisy.
-->
<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level [scenarioId=%X{scenarioId} testRunId=%X{testRunId} correlationId=%X{correlationId} step=%X{stepId}/%X{stepType}] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    <root level="WARN">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
