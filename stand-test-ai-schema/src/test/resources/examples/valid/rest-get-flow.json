{
  "id": "rest-get-flow",
  "title": "Read a resource",
  "environment": "ift",
  "tags": ["smoke"],
  "steps": [
    {
      "id": "read-request",
      "type": "rest.get",
      "description": "Read the request projection",
      "service": "client-service",
      "path": "/api/requests/latest",
      "headers": { "Accept": "application/json" },
      "correlation": { "inject": true },
      "expect": { "status": 200 },
      "capture": { "requestId": "$.requestId" }
    }
  ]
}
