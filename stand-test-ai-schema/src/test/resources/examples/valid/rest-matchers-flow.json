{
  "id": "rest-matchers-flow",
  "title": "REST GET asserting with the four non-equals matchers",
  "environment": "ift",
  "steps": [
    {
      "id": "read-packages",
      "type": "rest.get",
      "description": "Read the package description and assert composition with matchers",
      "service": "client-service",
      "path": "/api/packages",
      "expect": { "status": 200 },
      "assert": [
        { "path": "$.packages", "contains": "P_AS" },
        { "path": "$.requestId", "matches": "r-[0-9]+" },
        { "path": "$.connection", "exists": true },
        { "path": "$.error", "exists": false },
        { "path": "$.clientCode", "notNull": true }
      ]
    }
  ]
}
