{
  "id": "kafka-response-flow",
  "title": "Send command, expect response",
  "environment": "dev",
  "tags": ["integration"],
  "steps": [
    {
      "id": "send-command",
      "type": "kafka.send",
      "description": "Publish a command message",
      "topic": "command-topic",
      "key": "${correlationId}",
      "correlation": { "inject": true },
      "payload": { "fixture": "fixtures/command.json" }
    },
    {
      "id": "expect-response",
      "type": "kafka.expect",
      "description": "Expect the correlated response message",
      "topic": "response-topic",
      "correlation": { "fromContext": true },
      "timeout": "20s",
      "assert": [
        { "path": "$.status", "equals": "SUCCESS" }
      ]
    }
  ]
}
