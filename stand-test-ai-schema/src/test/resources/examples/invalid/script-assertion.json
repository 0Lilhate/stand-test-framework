{
  "id": "script-assertion",
  "title": "Rejected: assertion carries a script matcher instead of a declarative one",
  "environment": "ift",
  "steps": [
    {
      "id": "await-response-event",
      "type": "kafka.expect",
      "topic": "response-topic",
      "correlation": { "fromContext": true },
      "timeout": "20s",
      "assert": [
        { "path": "$.status", "script": "value == 'SUCCESS' || true" }
      ]
    }
  ]
}
