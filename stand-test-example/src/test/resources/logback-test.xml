<?xml version="1.0" encoding="UTF-8"?>
<!--
  Example (consumer-side) Logback config. The stand-test SDK ships only slf4j-api; the consumer supplies
  the binding and decides levels/format. This is the recommended starting point: the correlation ids the
  SDK stamps into the MDC (scenarioId / testRunId / correlationId / stepId / stepType / stepIndex, plan
  §17) are rendered on every line, and the SDK's own packages are raised to DEBUG so the scenario/step
  lifecycle and the per-adapter request traces are visible when you run the example. Third-party noise is
  kept at WARN.
-->
<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level [scenario=%X{scenarioId} run=%X{testRunId} corr=%X{correlationId} step=%X{stepIndex}:%X{stepId}(%X{stepType})] %logger{0} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- The SDK's own lifecycle + adapter DEBUG traces. -->
    <logger name="ru.alfa.stand.test" level="DEBUG"/>

    <root level="WARN">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
