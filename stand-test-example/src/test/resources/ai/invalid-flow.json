{
  "id": "invalid-ai-flow",
  "title": "Deliberately invalid document: every step violates a schema guardrail",
  "environment": "ift",
  "steps": [
    {
      "id": "delete-everything",
      "type": "db.delete",
      "datasource": "main-db",
      "query": "DELETE FROM requests"
    },
    {
      "id": "call-hardcoded-host",
      "type": "rest.post",
      "service": "https://real-stand.example",
      "path": "/api/requests",
      "expect": { "status": 200 }
    },
    {
      "id": "wait-forever",
      "type": "db.expectEventually",
      "datasource": "main-db",
      "timeout": "24h",
      "query": "SELECT status FROM requests WHERE request_id = :requestId",
      "expect": { "singleValue": "DONE" }
    }
  ]
}
