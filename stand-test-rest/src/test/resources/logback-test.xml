<?xml version="1.0" encoding="UTF-8"?>
<!--
  Test-only Logback config for stand-test-rest. Keeps unit-test output quiet (WARN and above) while
  demonstrating the correlation pattern the SDK stamps into the MDC (plan §17). The REST adapter's
  metadata-only DEBUG tracing stays suppressed on the console here (a ListAppender raised to DEBUG in a
  focused test still captures it) so the test log is not noisy.
-->
<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level [scenarioId=%X{scenarioId} testRunId=%X{testRunId} correlationId=%X{correlationId} step=%X{stepId}/%X{stepType}] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    <root level="WARN">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
